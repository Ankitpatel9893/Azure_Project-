				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('Azuresqllink_properties_typeProperties_server')]",
					"database": "[parameters('Azuresqllink_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('Azuresqllink_properties_typeProperties_userName')]",
