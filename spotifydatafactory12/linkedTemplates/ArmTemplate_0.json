			"defaultValue": "spotifydatafactory12"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"Azuresqllink_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Azuresqllink'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ankitspotifystorage.dfs.core.windows.net/"
