		"Azuresqllink_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azuresqlserverankit.database.windows.net"
		},
		"Azuresqllink_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ankitprojectdb"
		},
		"Azuresqllink_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminankit"
		}
	},
