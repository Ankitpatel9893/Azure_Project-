													"referenceName": "Azuresqllink",
													"type": "LinkedServiceReference"
												},
												"typeProperties": {
													"scripts": [
														{
															"type": "Query",
															"text": {
																"value": "select MAX(@{item().cdc_column}) as cdc From @{item().schema}.@{item().Table}",
																"type": "Expression"
															}
														}
													],
													"scriptBlockExecutionTimeout": "02:00:00"
